# API Base URL (leave empty to use same-origin or Vite proxy)
VITE_API_BASE_URL=

# Firebase Authentication — Firebase console > Project settings > Your apps > Web app
# Enable the Email/Password and Google sign-in providers under Authentication > Sign-in method.
# These values are public client identifiers (not secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Local development with the Firebase Auth Emulator (run `make firebase-emulator`).
# Use any placeholder values above (e.g. demo-credenviel) and set the host below.
# Ignored by production builds.
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
