# Environment Variables — copy to .env and fill in real values
# NEVER commit .env to source control

# Application Environment & Auth Mode
APP_ENV=local
AUTH_MODE=dev
INTERNAL_API_KEY=localdev-internal-key-secret-1234
PUBLIC_BASE_URL=http://localhost:8080
MAX_UPLOAD_BYTES=4194304

# Database
# Note: Host port is 5433 to prevent conflict with host services; inside Docker it is 5432
DATABASE_URL=postgres://credenviel:localdev@localhost:5433/credenviel?sslmode=disable
PGHOST=localhost
PGPORT=5433
PGUSER=credenviel
PGPASSWORD=localdev

# Local Storage & Queue Settings
LOCAL_STORAGE_ROOT=.local-storage
QUEUE_LOCK_DURATION=30
QUEUE_MAX_DELIVERY=5

# Worker Settings
CONFIDENCE_THRESHOLD=0.85
API_INTERNAL_URL=http://localhost:8080
QUEUE_NAME=job-processing
BLOB_CONTAINER=raw-uploads

# Backend Selection (Phase 2b — default is local for offline development)
QUEUE_BACKEND=local      # local | servicebus
STORE_BACKEND=local      # local | blob

# Azure Cloud Settings (used when QUEUE_BACKEND=servicebus or STORE_BACKEND=blob)
# When using 'make run-api-azure' or 'make test-azure', these are injected automatically
# from Key Vault and resource discovery via scripts/run_with_azure_env.py
STORAGE_ACCOUNT_NAME=
SERVICEBUS_FQDN=
SERVICEBUS_QUEUE=job-processing
AZURE_CLIENT_ID=

# Targets the local Azurite emulator for local development without secret keys
BLOB_CONNECTION_STRING=UseDevelopmentStorage=true
QUEUE_CONNECTION_STRING=
QUEUE_URL=
SIGNALR_URL=
KEY_VAULT_URL=
DOC_INTELLIGENCE_ENDPOINT=
DOC_INTELLIGENCE_KEY=
DOC_INTELLIGENCE_MODEL_ID=
